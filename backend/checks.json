    {
      "id": "bp.row_group_size",
      "severity": "warning",
      "section": "geoparquet_best_practices",
      "sampled": false,
      "description": "Row group size is outside 50k to 150k rows.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/main/format-specs/distributing-geoparquet.md#row-group-size"
      ]
    },
    {
      "id": "bp.version",
      "severity": "warning",
      "section": "geoparquet_best_practices",
      "sampled": false,
      "description": "GeoParquet 1.0, or 1.1 without a bbox covering.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/main/format-specs/distributing-geoparquet.md#efficient-spatial-access"
      ]
    },
    {
      "id": "bp.file_size",
      "severity": "warning",
      "section": "geoparquet_best_practices",
      "sampled": false,
      "description": "The file is larger than about 2 GB.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/main/format-specs/distributing-geoparquet.md#spatial-partitioning"
      ]
    },
