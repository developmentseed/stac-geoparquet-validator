      "id": "sample.skipped",
      "severity": "info",
      "section": null,
      "sampled": false,
      "description": "A sampled check was skipped because the sample could not be read: the time budget ran out, even the first row group's sampled columns exceed the 128 MiB read budget, or the rows could not be read. Its reference is that of the skipped check.",
      "references": []
    }
  ],
  "retired": []
}
