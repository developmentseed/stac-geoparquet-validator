      "id": "bp.extension",
      "severity": "warning",
      "section": "geoparquet_best_practices",
      "sampled": false,
      "description": "The file uses a `.geoparquet` extension.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/main/format-specs/geoparquet.md#file-extension"
      ]
