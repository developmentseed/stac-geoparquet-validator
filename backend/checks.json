      }
    },
    {
      "section": "geoparquet",
      "title": "GeoParquet",
      "source": {
        "title": "GeoParquet specification",
        "href": "https://github.com/opengeospatial/geoparquet/blob/main/format-specs/geoparquet.md"
      }
    },
    {
      "section": "geoparquet_best_practices",
      "title": "GeoParquet best practices",
      "source": {
        "title": "Distributing GeoParquet",
        "href": "https://github.com/opengeospatial/geoparquet/blob/main/format-specs/distributing-geoparquet.md"
      }
    },
    {
      "section": "stac_geoparquet",
      "title": "stac-geoparquet",
      "source": {
        "title": "stac-geoparquet specification",
        "href": "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md"
      }
    },
    {
      "section": "stac_geoparquet_best_practices",
      "title": "stac-geoparquet best practices",
      "source": {
        "title": "stac-geoparquet best practices",
        "href": "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/docs/best-practices.md"
      }
    }
