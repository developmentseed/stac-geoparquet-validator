      "sampled": false,
      "description": "A `collections` key differs from its collection's `id`.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#stac-collection-objects"
      ]
    },
    {
      "id": "stac.deprecated_collection",
      "severity": "warning",
      "section": "stac_geoparquet",
      "sampled": false,
      "description": "The deprecated `collection` key is used.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#stac-collection-objects"
      ]
    },
    {
      "id": "stac.type_column",
      "severity": "warning",
      "section": "stac_geoparquet",
      "sampled": false,
      "description": "A `type` column is present.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#guidelines"
      ]
    },
    {
      "id": "stac.duplicate_id",
      "severity": "error",
      "section": "stac_geoparquet",
      "sampled": true,
      "description": "Duplicate `id`s within a collection in the sample.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#guidelines"
      ]
    },
