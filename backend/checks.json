      "severity": "warning",
      "section": "geoparquet_best_practices",
      "sampled": false,
      "description": "Compression is not zstd.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/main/format-specs/distributing-geoparquet.md#compression"
      ]
