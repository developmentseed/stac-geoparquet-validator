  "checks": [
    {
      "id": "parquet.unreadable",
      "severity": "error",
      "section": "parquet",
      "sampled": false,
      "description": "The file cannot be fetched, has bad magic bytes, an unparseable footer, or the read timed out.",
      "references": [
        "https://parquet.apache.org/docs/file-format/"
      ]
    },
    {
      "id": "parquet.info",
      "severity": "info",
      "section": "parquet",
      "sampled": false,
      "description": "Parquet format version, creator, row and row group counts, file size.",
      "references": [
        "https://parquet.apache.org/docs/file-format/"
      ]
    },
    {
      "id": "geoparquet.metadata_missing",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "The `geo` metadata key is missing.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#file-metadata"
      ]
    },
    {
      "id": "geoparquet.metadata_invalid_json",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "The `geo` metadata is not valid JSON.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#file-metadata"
      ]
    },
    {
      "id": "geoparquet.metadata_schema",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "The `geo` metadata fails the JSON Schema for its declared version.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#file-metadata"
      ]
    },
    {
      "id": "geoparquet.unknown_version",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "The declared GeoParquet version is not 1.0, 1.1 or 2.0.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#version-and-schema"
      ]
    },
    {
      "id": "geoparquet.primary_column_missing",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "`primary_column` is not in `columns`.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#file-metadata"
      ]
    },
    {
      "id": "geoparquet.column_missing",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "A geometry column listed in the metadata is missing from the schema.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#column-metadata"
      ]
    },
    {
      "id": "geoparquet.column_nested",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "A geometry column is nested.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#nesting"
      ]
    },
    {
      "id": "geoparquet.column_repeated",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "A geometry column is repeated.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#repetition"
      ]
    },
    {
      "id": "geoparquet.encoding",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "The encoding is invalid for the declared version.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#encoding"
      ]
    },
    {
      "id": "geoparquet.crs_mismatch",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "The `geo` CRS contradicts the native logical-type CRS (any version).",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#crs-parquet-property"
      ]
    },
    {
      "id": "geoparquet.geometry_types_duplicate",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "Duplicate values in `geometry_types`.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#geometry_types"
      ]
    },
    {
      "id": "geoparquet.covering_invalid",
      "severity": "error",
      "section": "geoparquet",
      "sampled": false,
      "description": "The bbox covering is malformed.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#covering"
      ]
    },
    {
      "id": "geoparquet.native_types",
      "severity": "compat",
      "section": "geoparquet",
      "sampled": false,
      "description": "Native `GEOMETRY`/`GEOGRAPHY` logical types, which some readers cannot handle.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#geometry-columns"
      ]
    },
    {
      "id": "geoparquet.native_without_metadata",
      "severity": "warning",
      "section": "geoparquet",
      "sampled": false,
      "description": "Native geospatial types without `geo` metadata.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#metadata"
      ]
    },
    {
      "id": "geoparquet.info",
      "severity": "info",
      "section": "geoparquet",
      "sampled": false,
      "description": "GeoParquet version, geometry types, CRS and bbox.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#column-metadata"
      ]
    },
    {
      "id": "geoparquet.geometry_types_mismatch",
      "severity": "warning",
      "section": "geoparquet",
      "sampled": true,
      "description": "`geometry_types` does not match the geometries seen in the sample.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/v2.0.0/format-specs/geoparquet.md#geometry_types"
      ]
    },
    {
