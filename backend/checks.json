      "id": "stac.column_type",
      "severity": "error",
      "section": "stac_geoparquet",
      "sampled": false,
      "description": "A column has the wrong type.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#guidelines",
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#link-struct",
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#asset-struct"
      ]
    },
