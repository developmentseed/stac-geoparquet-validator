      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#guidelines"
      ]
    },
    {
      "id": "stac.crs",
      "severity": "error",
      "section": "stac_geoparquet",
      "sampled": false,
      "description": "The geometry CRS is not OGC:CRS84.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#guidelines"
      ]
    },
    {
      "id": "stac.metadata_missing",
      "severity": "error",
      "section": "stac_geoparquet",
      "sampled": false,
      "description": "The `stac-geoparquet` metadata key is missing.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/stac-geoparquet-spec.md#parquet-metadata"
      ]
    },
