      "severity": "warning",
      "section": "geoparquet_best_practices",
      "sampled": true,
      "description": "The file does not look spatially ordered.",
      "references": [
        "https://github.com/opengeospatial/geoparquet/blob/main/format-specs/distributing-geoparquet.md#spatial-ordering"
      ]
