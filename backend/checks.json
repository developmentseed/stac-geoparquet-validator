      "id": "stacbp.spatiotemporal_order",
      "severity": "warning",
      "section": "stac_geoparquet_best_practices",
      "sampled": true,
      "description": "The file is not spatio-temporally ordered.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/docs/best-practices.md#use-spatio-temporal-ordering"
      ]
    },
    {
      "id": "stacbp.id_prefix",
      "severity": "warning",
      "section": "stac_geoparquet_best_practices",
      "sampled": true,
      "description": "Ids are not prefixed with an ordering key.",
      "references": [
        "https://github.com/radiantearth/stac-geoparquet-spec/blob/main/docs/best-practices.md#prefix-item-ids-with-the-spatio-temporal-ordering-key"
